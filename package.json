{
  "name": "fashion-e-commerce",
  "version": "1.1.0",
  "description": "Fashion e-commerce home page: HTML, SCSS, Owl Carousel",
  "private": true,
  "scripts": {
    "build": "sass scss/style.scss css/style.css --no-source-map --silence-deprecation=import --silence-deprecation=global-builtin --silence-deprecation=color-functions",
    "watch": "sass --watch scss/style.scss css/style.css --no-source-map --silence-deprecation=import --silence-deprecation=global-builtin --silence-deprecation=color-functions",
    "serve": "browser-sync start --server --files \"css/*.css, *.html, js/*.js\" --no-notify",
    "start": "npm run build && (npm run watch & npm run serve)"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IlyaBielov/Fashion-E-commerce.git"
  },
  "author": "Ilya Bielov",
  "license": "ISC",
  "homepage": "https://github.com/IlyaBielov/Fashion-E-commerce#readme",
  "devDependencies": {
    "browser-sync": "^3.0.4",
    "sass": "^1.108.2"
  }
}
